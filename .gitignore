# Node / Frontend (React + Vite)
# =============================================================================

node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# Vite cache
frontend/.vite-cache/

# npm / yarn / pnpm lockfiles generated locally (keep package-lock.json)
.yarn-integrity
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# =============================================================================
# Environment & Secrets
# =============================================================================

.env
.env.*
!.env.example
!.env.template

# =============================================================================
# Data files (keep the data/ folder structure but not the raw data blobs)
# =============================================================================

data/*.csv
data/*.json
data/*.parquet
data/*.feather
data/*.xlsx
data/*.xls
data/*.pkl
data/*.pickle
data/*.h5
data/*.hdf5
# Keep .gitkeep and README.md so the folder structure is preserved
!data/.gitkeep
!data/README.md

# =============================================================================
# Backend build artefacts (served via FastAPI's StaticFiles mount)
# =============================================================================

backend/static/

# =============================================================================
# Docker
# =============================================================================

